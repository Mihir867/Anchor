# --- Storage (optional; both independent) -------------------------------------------
# Postgres for runs + posts. Tables are created automatically on first use.
DATABASE_URL=postgresql://user:password@host:5432/anchor
# Cloudinary for slides/PDFs/logos. Either the single URL (Dashboard -> API environment variable)...
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the three parts:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=anchor
