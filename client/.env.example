# Engine (FastAPI) base URL; used for POST /runs and as a fallback when the DB is not configured.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Same Postgres the engine writes to (server-side only; never prefix with NEXT_PUBLIC_).
# Hosted providers: add ?sslmode=require if they need it.
DATABASE_URL=postgresql://user:password@host:5432/anchor
